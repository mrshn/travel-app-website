rules_version = '2';

// Travels: any Google account can sign in, and each account reads and writes only its own trips and progress.
// Everything else is denied (the old meta/owner document stays as it is: nothing reads it any more).
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // One document per trip and per trip's progress, stored as JSON text, named "{kind}-{ref}" (sync.ts itemKey),
    // with nothing else in it; `deleted` marks a deletion (a tombstone).
    match /users/{uid}/items/{item} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['kind', 'ref', 'json', 'updatedAt', 'deleted'])
        && request.resource.data.kind in ['trip', 'progress']
        && request.resource.data.ref is string
        && item == request.resource.data.kind + '-' + request.resource.data.ref
        && request.resource.data.json is string
        && request.resource.data.json.size() < 1000000
        && request.resource.data.updatedAt is int
        && (!('deleted' in request.resource.data) || request.resource.data.deleted is bool);
    }
  }
}
