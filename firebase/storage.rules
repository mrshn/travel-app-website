rules_version = '2';

// Photos you add to stops, in your own folder only. Photos you post or send to a group trip's chat go in your
// public folder: signed-in people see them (the app shows them by their link), and only you add or remove them
// (docs/design/2026-10-14-together.md, 6.1).
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/photos/{photo} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // At most 4 MB, an image (uploadPublicPhoto of app/lib/social/firestore.ts says the same).
    match /users/{uid}/public/{photo} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size <= 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
